# Baseten: the model every chat runs on, called on its OpenAI-compatible Chat Completions API.
BASETEN_API_KEY=
BASETEN_MODEL=zai-org/GLM-5.3-Flash
# Optional: sent as `reasoning_effort` in every request (GLM-5.3-Flash takes none, low, high, max).
BASETEN_REASONING_EFFORT=low

# Optional: chat traces to Phoenix (Arize). Tracing is off unless OTLP_ENDPOINT and OTLP_API_KEY are set.
OTLP_ENDPOINT=
OTLP_AUTH_HEADER=authorization
OTLP_API_KEY=
# PHOENIX_PROJECT_NAME=load-skills-poc

PORT=3000
